MEALIE_BASE_URL=http://your-mealie-instance:9000
MEALIE_TOKEN=your_long_lived_api_token
# Only needed for recipe generation
ANTHROPIC_API_KEY=sk-ant-...
# Optional: set to require a login
APP_PASSWORD=
# Optional: without a password the app only answers to IP addresses and local
# names; list any domain name you open it by, e.g. planner.example.com
ALLOWED_HOSTS=
# Docker Compose only
TZ=Pacific/Auckland
# User and group the container runs as; must be able to write ./data
PUID=568
PGID=568
